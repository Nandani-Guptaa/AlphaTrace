# AlphaTrace Configuration

# FalkorDB Graph Database
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_GRAPH=alphatrace_risk_graph
FALKORDB_PASSWORD=

# Backend API
API_HOST=0.0.0.0
API_PORT=8000
