# Streamlit Frontend
STREAMLIT_PORT=8501

# Agent & LLM (Optional Local Ollama, Deterministic Engine runs without LLM)
USE_OLLAMA=false
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
